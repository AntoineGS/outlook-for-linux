{
  "name": "outlook-for-linux",
  "version": "2.0.0",
  "desktopName": "outlook-for-linux",
  "main": "app/index.js",
  "description": "Unofficial client for Microsoft Outlook for Linux",
  "homepage": "https://github.com/AntoineGS/outlook-for-linux",
  "keywords": [
    "Outlook",
    "email",
    "calendar",
    "productivity"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://github.com/AntoineGS/outlook-for-linux"
  },
  "author": {
    "name": "Antoine Gaudreau Simard, prev. Mahmoud Bahaa, Ismael Martinez",
    "email": "antoineg.simard@gmail.com",
    "url": "https://github.com/AntoineGS/"
  },
  "license": "GPL-3.0-or-later",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint **/*.js",
    "test:unit": "node --test 'tests/unit/*.test.js'",
    "test:vim-renderer": "DISPLAY=${DISPLAY:-:1} WAYLAND_DISPLAY= electron --no-sandbox --ozone-platform=x11 tests/probes/vimRichTextProbe.js",
    "test:outlook-runtime-renderer": "npm run build:outlook-runtime && DISPLAY=${DISPLAY:-:1} WAYLAND_DISPLAY= electron --ozone-platform=x11 tests/probes/outlookBrowserRuntimeProbe.js",
    "test:e2e": "playwright test",
    "test:authenticated": "playwright test --config playwright.authenticated.config.js",
    "cross-distro": "cd tests/cross-distro && ./run.sh",
    "cross-distro:list": "cd tests/cross-distro && ./run.sh --list",
    "cross-distro:smoke": "cd tests/cross-distro && ./scripts/smoke-check.sh",
    "prestart": "npm ci && npm run build:outlook-runtime",
    "start": "electron ./app --trace-warnings",
    "prestart:dev": "npm run build:outlook-runtime",
    "start:dev": "electron ./app --trace-warnings --no-sandbox",
    "build:outlook-runtime": "node scripts/buildOutlookBrowserRuntime.js",
    "pretest:e2e": "npm run build:outlook-runtime",
    "pretest:authenticated": "npm run build:outlook-runtime",
    "generate-release-info": "node scripts/generateReleaseInfo.js",
    "generate-ipc-docs": "node scripts/generateIpcDocs.js",
    "generate-config-docs": "node scripts/generateConfigDocs.js",
    "verify:vim-package": "node scripts/verifyVimEditingPackage.js",
    "prebuild": "npm run generate-release-info",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:linux:targz": "electron-builder --x64 --armv7l --arm64 -l tar.gz",
    "dist:linux:deb": "electron-builder --x64 --armv7l --arm64 -l deb",
    "dist:linux:rpm": "electron-builder --x64 --armv7l --arm64 -l rpm",
    "dist:linux:appimage": "electron-builder --x64 --armv7l --arm64 -l AppImage",
    "dist:linux:snap": "electron-builder -l snap",
    "dist:linux:snap:armv7l": "electron-builder --armv7l -l snap",
    "dist:linux:snap:arm64": "electron-builder --arm64 -l snap",
    "dist:mac:x64": "electron-builder --mac --x64",
    "dist:mac:arm64": "electron-builder --mac --arm64",
    "dist:windows": "electron-builder --windows --x64",
    "dist:linux:x64": "electron-builder --x64 -l tar.gz deb rpm AppImage",
    "dist:linux:arm64": "electron-builder --arm64 -l tar.gz deb rpm AppImage",
    "dist:linux:arm": "electron-builder --armv7l -l tar.gz deb rpm AppImage",
    "release": "electron-builder"
  },
  "dependencies": {
    "@homebridge/dbus-native": "0.7.9",
    "cbor-x": "^1.6.5",
    "electron-log": "^5.4.4",
    "electron-store": "11.0.2",
    "electron-updater": "^6.8.9",
    "electron-window-state": "5.0.3",
    "mqtt": "^5.15.2",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@replit/codemirror-vim-core": "0.1.0",
    "electron": "42.9.3",
    "electron-builder": "26.15.7",
    "esbuild": "0.28.2",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "http-server": "^14.1.1",
    "xml2js": "^0.6.2"
  },
  "overrides": {
    "follow-redirects": "^1.16.0"
  },
  "build": {
    "appId": "outlook-for-linux",
    "files": [
      "**/*",
      "!tests{,/**/*}",
      "!.worktrees{,/**/*}",
      "!.superpowers{,/**/*}",
      "!docs/superpowers/plans{,/**/*}",
      "!docs/superpowers/specs{,/**/*}",
      "!docs/superpowers/reports{,/**/*}",
      "!docs-site{,/**/*}",
      "!scripts{,/**/*}",
      "!app/assets/icons/T4L Logo 2024.zip",
      "!app/browser/outlookBrowserRuntime.js",
      "!app/browser/tools/{outlookActions,outlookComposer,richTextPositionMap,richTextVimAdapter,vimBindings,vimCore,vimEditing}.js",
      "!test-results{,/**/*}",
      "!playwright-report{,/**/*}"
    ],
    "asarUnpack": [
      "node_modules/spellchecker/vendor/hunspell_dictionaries"
    ],
    "protocols": {
      "name": "msoutlook",
      "schemes": [
        "msoutlook"
      ]
    },
    "extraResources": [
      {
        "from": "app/assets/sounds",
        "to": "assets/sounds"
      }
    ],
    "linux": {
      "category": "Chat;Network;Office",
      "packageCategory": "net",
      "executableName": "outlook-for-linux",
      "syncDesktopName": true,
      "synopsis": "Outlook for Linux",
      "description": "Unofficial Microsoft Outlook client for Linux using Electron. It uses the Web App and wraps it as a standalone application using Electron.",
      "executableArgs": [
        "--ozone-platform=x11"
      ],
      "desktop": {
        "entry": {
          "Name": "Outlook for Linux",
          "Comment": "Unofficial client for Microsoft Outlook for Linux",
          "StartupWMClass": "outlook-for-linux"
        }
      },
      "target": [
        "rpm",
        "deb",
        "tar.gz",
        "AppImage"
      ],
      "publish": {
        "provider": "github",
        "releaseType": "draft"
      },
      "releaseInfo": {
        "releaseNotesFile": "release-info.json"
      }
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)"
      ],
      "fpm": [
        "--rpm-rpmbuild-define=_build_id_links  none",
        "--rpm-digest=sha256",
        "--rpm-tag=Recommends: fido2-tools"
      ]
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "libxss",
        "alsa-lib",
        "at-spi2-core",
        "libnotify",
        "xdg-utils"
      ]
    },
    "deb": {
      "recommends": [
        "libappindicator3-1",
        "fido2-tools"
      ]
    },
    "snap": {
      "summary": "Outlook for Linux",
      "confinement": "strict",
      "grade": "stable",
      "base": "core22",
      "executableArgs": [
        "--ozone-platform=x11"
      ],
      "plugs": [
        "default",
        "audio-record",
        "camera",
        "hardware-observe",
        "network-bind",
        "network-manager-observe",
        "removable-media",
        "screen-inhibit-control",
        "system-observe",
        "upower-observe"
      ],
      "publish": [
        "snapStore"
      ]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "beforePack": "scripts/buildOutlookBrowserRuntime.js",
    "afterPack": "scripts/afterpack.js"
  }
}
