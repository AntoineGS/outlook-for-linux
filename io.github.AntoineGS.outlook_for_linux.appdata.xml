  <name>Outlook for Linux</name>
  <summary>Unofficial Microsoft Outlook client for Linux</summary>
  <description>
    <p>Experience Microsoft Outlook on Linux in a standalone Electron application that wraps the Outlook web app.</p>
    <p>This application is an unofficial client and is not affiliated with Microsoft.</p>
  </description>
  <url type="homepage">https://github.com/AntoineGS/outlook-for-linux</url>
  <url type="help">https://github.com/AntoineGS/outlook-for-linux/blob/main/README.md</url>
  <url type="bugtracker">https://github.com/AntoineGS/outlook-for-linux/issues</url>
  <launchable type="desktop-id">outlook-for-linux.desktop</launchable>
  <releases>
    <release version="2.0.0" date="2026-08-29">
      <description>
        <ul>
          <li>Initial Outlook for Linux 2.0 release based on the Teams for Linux Electron wrapper.</li>
          <li>Provides Outlook desktop integration, notifications, multi-account profiles, and secure Microsoft sign-in support.</li>
          <li>Adds opt-in Vim mailbox navigation and rich-text message editing.</li>
          <li>Removes Teams-only runtime behavior and hardens Outlook product boundaries.</li>
        </ul>
      </description>
    </release>
  </releases>
